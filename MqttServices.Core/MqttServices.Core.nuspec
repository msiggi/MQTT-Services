<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
	<metadata>
		<id>MQTT-Services</id>
		<version>$Version$</version>
		<authors>$Authors$</authors>
		<projectUrl>$PackageProjectUrl$</projectUrl>
		<description>$Description$</description>
		<repository url="$RepositoryUrl$" />
		<dependencies>
			<group targetFramework="net10.0">
				<dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.0" exclude="Build,Analyzers" />
				<dependency id="Microsoft.Extensions.Configuration.Abstractions" version="10.0.0" />
				<dependency id="Microsoft.Extensions.Hosting" version="10.0.0" />
				<dependency id="Microsoft.Extensions.Options.ConfigurationExtensions" version="10.0.0" />
				<dependency id="MQTTnet" version="5.0.1.1416" />
				<dependency id="MQTTnet.Server" version="5.0.1.1416" />
			</group>
		</dependencies>
		<icon>Logo2.png</icon>
	</metadata>
	<files>
		<file src="Logo2.png" target="" />
	</files>
</package>