{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "MqttServices.Core": "Information",
      "MqttServices.Core.MqttNet": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "MqttClientSettings": {
    "Enabled": true,
    "ServiceName": "SampleWorkerService_BrokerAndClient",
    "BrokerHost": "localhost",
    "BrokerPort": 8883,
    "UserName": "Testuser",
    "Password": "SecRet",
    "EncryptWithTls": true,
    "AllowUntrustedCertificates": true
  },
  "MqttBrokerSettings": {
    "EnableBroker": true,
    "Port": 1883,
    "Users": [
      {
        "UserName": "Testuser",
        "Password": "SecRet"
      }
    ],
    "DelayInMilliSeconds": 30000,
    "TlsPort": 8883,
    "Certificate": {
      "Path": "broker-certificate.pfx"
    }
  }
}
